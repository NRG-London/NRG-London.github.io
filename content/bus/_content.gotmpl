{{- /*
  Content adapter — one page per bus route, built from data/bus/weekly.json.

  ~616 pages and not one content file on disk. The alternative was generating
  616 stub markdown files, which would mean 616 changed files in every weekly
  data refresh; this way a refresh touches the data and nothing else.

  Hugo lowercases page paths, so route N136 is served at /bus/n136/. Every link
  to a route page must agree: templates use `lower`, and ngbus-table.js has a
  slug() doing the same thing.

  Each page carries only its identity in params. The weekly series is read from
  hugo.Data.bus.routes.<route> by layouts/bus/single.html — putting a whole
  history into page params would hold all 616 of them in memory at once for no
  gain.

  Public since the soft launch (Neil, 18 Oct 2026): the three unlisting
  switches (`build.list: never`, `sitemap.disable`, `noindex`) are gone. The
  site's listings are all section-scoped (campaigns, library, campaign terms),
  so in site.Pages these pages leak nowhere: a build with and without the
  switches differs only in /bus/ and sitemap.xml. `priority -1` leaves the
  sitemap's priority out, as for every other page (an added page would
  otherwise say 0).
*/ -}}

{{- $d := hugo.Data.bus.weekly -}}
{{- if not $d -}}
  {{- errorf "content/bus/_content.gotmpl: no data/bus/weekly.json. Run scripts/make_bus_sample.py." -}}
{{- end -}}

{{- range $d.routes -}}
  {{- /* /bus/replay/ is the replay viewer (content/bus/replay.md). A route
         of that name would silently fight it for the address. */ -}}
  {{- if eq (lower .route) "replay" -}}
    {{- errorf "content/bus/_content.gotmpl: a route called %q would collide with /bus/replay/" .route -}}
  {{- end -}}
  {{- $.AddPage (dict
      "path" (lower .route)
      "kind" "page"
      "title" (printf "Bus route %s" .route)
      "description" (printf "Excess wait time and reliability for London bus route %s, week by week." .route)
      "sitemap" (dict "priority" -1)
      "params" (dict
        "route" .route
        "deck" .deck
        "vehicle_model" .vehicle_model
      )
  ) -}}
{{- end -}}

{{- /* Holding pages: routes TfL runs that the sweep cannot measure yet, and so
       has no page for (data/bus/holding.yaml; layouts/bus/holding.html). One
       that already has a page (W14) keeps it, with the holding words in its
       headline. These stay out of search and the sitemap even once the route
       pages go public: they are placeholders, there to be found from the A-Z
       and by anyone typing the address, not to be indexed. */ -}}
{{- $known := slice -}}
{{- range $d.routes }}{{ $known = $known | append .route }}{{ end -}}
{{- range hugo.Data.bus.holding.routes -}}
  {{- if not (in $known .route) -}}
  {{- $.AddPage (dict
      "path" (lower .route)
      "kind" "page"
      "layout" "holding"
      "title" (printf "Bus route %s" .route)
      "description" (printf "London bus route %s: introduced or changed since TfL's 2024 stop list, so not measured yet." .route)
      "build" (dict "list" "never" "render" "always")
      "sitemap" (dict "disable" true)
      "params" (dict "route" .route "noindex" true "holding" true)
  ) -}}
  {{- end -}}
{{- end -}}
